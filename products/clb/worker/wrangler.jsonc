// Cloudflare Worker for the practice coach: serves the static export (../out) and handles /api/*.
// Keys checked against node_modules/wrangler/config-schema.json (wrangler 4.137.0) and
// cloudflare-docs src/content/docs/workers/static-assets/binding.mdx (fetched 2026-09-24).
//
// IDs: the owner runs the Actions workflow "Set up Cloudflare (one time)" (.github/workflows/setup-cloudflare.yml,
// owner-setup step 6); it creates the D1 databases and KV namespaces and prints their IDs, which are
// pasted below. Secrets are never stored here — see worker/src/env.ts.
//
// Plans (memo §7.2 Z2): everything here runs on Workers Free with the free workers.dev address — D1, KV,
// Workers AI (AI), static assets and Workers Logs are all available on Free, and the two crons per Worker
// (production + staging = 4) stay within the 5 Cron Triggers per account
// (cloudflare-docs workers/platform/limits.mdx, read 2026-09-24).
//
// Vars: the values below are placeholders and safe defaults for a deploy that bypasses deploy.yml.
// deploy.yml replaces every var with --var (vars not listed there are removed): SITE_URL, APP_VERSION,
// FROM_EMAIL (default: Resend's sandbox sender below), OWNER_EMAIL, MAILING_ADDRESS (when set), LEGAL_NAME,
// GOOGLE_CLIENT_ID (with the GOOGLE_CLIENT_SECRET secret), MAGIC_LINK ('owner') and LEARNER_EMAIL ('off')
// passed explicitly, GRADER_*, ANTHROPIC_MONTHLY_LIMIT_USD and, on production, ANTHROPIC_PREPAID_USD /
// ANTHROPIC_PREPAID_SINCE (ops/config/anthropic-limit.json). MAGIC_LINK and LEARNER_EMAIL are not set here:
// the Worker's defaults (shared/config.ts AUTH_DEFAULTS) are the same values.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "maple-practice-coach",
  "main": "src/index.ts",
  // workerd 1.20260815 (installed with wrangler/miniflare) supports dates up to 2026-08-15
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },

  "assets": {
    "directory": "../out",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mpc",
      // "database_id": "<from \"Set up Cloudflare (one time)\", target production>",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "FLAGS"
      // "id": "<from \"Set up Cloudflare (one time)\": maple-practice-coach-flags>"
    }
  ],
  "ai": { "binding": "AI" },

  // every 15 min: spend/error monitor; daily 05:00 UTC: retention purge + aggregate metrics
  "triggers": { "crons": ["*/15 * * * *", "0 5 * * *"] },

  "vars": {
    "SITE_URL": "https://maple-practice-coach.example.workers.dev",
    "APP_VERSION": "0.1.0",
    // Resend's sandbox sender: delivers only to the Resend account's own address (= OWNER_EMAIL), memo §7.2 Z4
    "FROM_EMAIL": "Maple Practice Coach <onboarding@resend.dev>",
    "MAILING_ADDRESS": "SET-BEFORE-LAUNCH (CASL: owner mailing address)",
    "OWNER_EMAIL": "owner@example.com"
  },

  // Staging Worker: `wrangler … --env staging` (deploy.yml, only by a manual run with target=staging,
  // memo §7.2 Z7). It has its own D1 database and KV namespace (D1 mpc-staging and KV
  // maple-practice-coach-staging-flags, both created by "Set up Cloudflare (one time)" with target staging; paste both ids below). Per
  // config-schema.json, vars, d1_databases, kv_namespaces and ai are NOT inherited from the top level,
  // so they are repeated here; main, assets, compatibility settings and observability are inherited.
  // deploy.yml overrides SITE_URL, APP_VERSION and the owner vars with --var, like production, and adds
  // ANTHROPIC_MONTHLY_LIMIT_USD (the eval workspace limit; no prepaid ledger). STAGING_ALLOWED_EMAILS locks staging: sign-in
  // links go only to those addresses and anonymous grading is off (worker/src/auth.ts stagingAllows).
  // deploy.yml always replaces the placeholder below with MPC_STAGING_ALLOWED_EMAILS (or MPC_OWNER_EMAIL)
  // and refuses to deploy staging without one; the placeholder keeps any other staging deploy locked.
  // Production must never define it (scripts/deploy-config.ts checks both).
  "env": {
    "staging": {
      "name": "maple-practice-coach-staging",
      "workers_dev": true,
      "preview_urls": false,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "mpc-staging",
          // "database_id": "<from \"Set up Cloudflare (one time)\", target staging>",
          "migrations_dir": "migrations"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "FLAGS"
          // "id": "<from \"Set up Cloudflare (one time)\": maple-practice-coach-staging-flags>"
        }
      ],
      "ai": { "binding": "AI" },
      // the same schedules as production, so the spend monitor and the daily job run on staging too
      "triggers": { "crons": ["*/15 * * * *", "0 5 * * *"] },
      "vars": {
        "SITE_URL": "https://maple-practice-coach-staging.example.workers.dev",
        "APP_VERSION": "0.1.0-staging",
        "FROM_EMAIL": "STAGING - Maple Practice Coach <onboarding@resend.dev>",
        "MAILING_ADDRESS": "SET-BEFORE-LAUNCH (CASL: owner mailing address)",
        "OWNER_EMAIL": "owner@example.com",
        "STAGING_ALLOWED_EMAILS": "owner@example.com"
      }
    }
  }
}
